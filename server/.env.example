# Puerto local. El nodo escucha en loopback; TLS lo termina Caddy/nginx delante.
PORT=8787
HOST=127.0.0.1

# Directorios donde se permite abrir sesiones de agente. Separados por ':'.
# session.open rechaza cualquier cwd que no esté bajo una de estas raíces.
ALLOWED_ROOTS=/home/tu-usuario/proyectos

# Token de dispositivo para desarrollo. En producción se usa `npm run pair`,
# que genera tokens ligados a una clave Ed25519 del Keystore de Android.
DEV_TOKEN=cambia-esto-por-algo-aleatorio-de-32-bytes

# Frames por sesión que se conservan para el replay tras reconectar.
REPLAY_BUFFER=500

# Motor por defecto: 'claude-code' es el único implementado.
DEFAULT_ENGINE=claude-code

# Modelo que usa el agente (alias del CLI: opus, sonnet, fable).
AGENT_MODEL=opus

# --- Credenciales ---
# Deliberadamente NO se define ANTHROPIC_API_KEY: sin ella, el Agent SDK delega
# en el binario de Claude Code, que usa las credenciales OAuth de ~/.claude del
# usuario que ejecuta el nodo. Eso es lo que hace que se consuma la SUSCRIPCIÓN
# y no la API de pago. Haz `claude login` una vez en el servidor.
#
# Si defines ANTHROPIC_API_KEY, se facturará por token contra la API.
# ANTHROPIC_API_KEY=

# --- Push (H2) ---
# PUSH_PROVIDER=fcm|unifiedpush|none
PUSH_PROVIDER=none
# FCM_SERVICE_ACCOUNT=/ruta/a/service-account.json
# NTFY_URL=https://ntfy.tu-dominio.tld
